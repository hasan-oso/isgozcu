# Supabase persistence (Phase 2C.2)
# - SUPABASE_URL: project URL, e.g. https://xxxxxxxxxxxx.supabase.co
# - SUPABASE_SERVICE_ROLE_KEY: backend-only key with RLS bypass.
#   The live simulator (`--supabase`) reads this for writes.
#   NEVER ship this key to the frontend or commit it to git.
# - SUPABASE_ANON_KEY: client-safe key for the future Next.js dashboard.
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Detection / inference defaults
# YOLO_MODEL_PATH is read by the live simulator as the default path when
# --detector rtdetr is selected without an explicit --model-path / --model-version.
YOLO_MODEL_PATH=backend/models/rtdetr_isgozcu_ppe_v2
CONFIDENCE_THRESHOLD=0.25
MIN_VIOLATION_DURATION_SECONDS=5
